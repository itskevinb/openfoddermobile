            '........####++++++++++++++++TTTTTTTT+++++++++++++++#####........',
            '........####++++++++++++++++TTTTTTTT+++++++++++++++#####........',
            '........####++++TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT++++#####........',
            '........####++++TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT++++#####........',
            '........####++++TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT++++#####........',
            '........####++++TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT++++#####........',
            '........####++++TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT++++#####........',
            '........####++++TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT++++#####........',
            '........####++++TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT++++#####........',
            '........####++++TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT++++#####........',
            '........####++++++++++++++++TTTTTTTT+++++++++++++++#####........',
            '........####++++++++++++++++TTTTTTTT+++++++++++++++#####........',
            '........####++++++++++++++++TTTTTTTT+++++++++++++++#####........',
            '........####++++++++++++++++TTTTTTTT+++++++++++++++#####........',
            '........################++++TTTTTTTT++++################........',
            '........################++++TTTTTTTT++++################........',
            '........################++++TTTTTTTT++++################........',
            '........################++++TTTTTTTT++++################........',
            '........################++++TTTTTTTT++++################........',
