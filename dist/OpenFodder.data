            }
        }

        return name;
    },

    nameMas: function() {
        rnd = Map.getRandomFloat(0, 1) * this.nm3.length | 0;
        rnd2 = Map.getRandomFloat(0, 1) * this.nm4.length | 0;
        nMs = this.nm3[rnd] + this.nm4[rnd2];
        return nMs;
    },

    Random: function() {
        return this.nameGen();
    }
};

