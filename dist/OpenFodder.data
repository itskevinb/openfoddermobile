var map_char = st.convertMapChar(_map_char);
var w = _map_char[0].length;
var h = _map_char.length;
var lev_limits = [0, 0, 0, 0, 0];
var map = st.run('cf1', 'jungle', 'char', w, h, map_char, lev_limits);

